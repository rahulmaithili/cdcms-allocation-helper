{
  "manifest_version": 3,
  "name": "CDCMS Allocation Helper",
  "version": "1.1.1",
  "description": "Automating cylinder allocation on HP Gas CDCMS by mapping area codes to delivery vendors.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://wyeejbncddpxhwtijkjt.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://hpgasweb.hpcl.co.in/DCMSCentralizationApp/Views/OrderFulfillment/Allocation/Allocation.aspx*",
        "*://hpgasweb.hpcl.co.in/DCMSCentralizationApp/Views/OrderFulfillment/PrintCashMemo/AllocationWiseCashMemoPrint.aspx*",
        "file://*/*mock_allocation.html*",
        "file://*/*mock_print.html*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
